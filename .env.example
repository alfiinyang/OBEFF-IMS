# OBEFF IMS - Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit your actual .env or .env.local file to version control.

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for administrative actions like bypassing RLS when creating admin accounts or running triggers
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transactional Email Service (Resend or AWS SES)
# If left empty in local dev, email notifications will be logged to server console
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="OBEFF Family Portal <notifications@yourfamilydomain.org>"

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
